# Copy to .Renviron for local machine-specific settings.
# Do not commit .Renviron itself.

# Location of the 2025 reference project on this machine.
# macOS example:
# FUELBURN_2025_PROJECT=/Users/<user>/RProjects/paper-2025-ICNS-CHN-EUR-fuelburn
#
# Windows example:
# FUELBURN_2025_PROJECT=C:/Users/<user>/Documents/RProjects/paper-2025-ICNS-CHN-EUR-fuelburn

# Optional: force CHN QAR fuel-flow units when known.
# Leave unset for automatic kg/h vs lb/h inference.
# CHN_QAR_FUEL_FLOW_UNIT=auto

# Optional: local EUR canonical milestone parquet used by the import smoke test.
# The same setting is also used by scripts/03-audit-eur-canonical-milestones.R.
# FUELBURN_EUR_CANONICAL_MILESTONES=/path/to/EUR-canonical-milestones-summer2025.parquet

# Optional: output folder for the EUR milestone audit CSV files.
# Defaults to data-derived/eur-canonical-milestone-audit.
# FUELBURN_EUR_MILESTONE_AUDIT_DIR=/path/to/local/audit-output
